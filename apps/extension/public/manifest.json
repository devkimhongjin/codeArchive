{
  "manifest_version": 3,
  "name": "CodeArchive",
  "version": "0.1.0",
  "description": "로컬 우선 코딩 테스트 풀이 기록 도구",
  "key": "",
  "permissions": ["identity"],
  "host_permissions": [
    "https://codearchive-api.onrender.com/*"
  ],
  "action": {
    "default_title": "CodeArchive",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": {
    "matches": [
      "https://codearchive-dashboard-beta.onrender.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://swexpertacademy.com/main/code/problem/problemDetail.do*",
        "https://swexpertacademy.com/main/code/contestProblem/contestProblemDetail.do*",
        "https://swexpertacademy.com/main/code/userProblem/userProblemDetail.do*",
        "https://swexpertacademy.com/main/solvingProblem/solvingProblem.do*"
      ],
      "js": ["content/swea.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://school.programmers.co.kr/learn/courses/30/lessons/*"
      ],
      "js": ["content/programmers.js"],
      "run_at": "document_idle"
    }
  ]
}
