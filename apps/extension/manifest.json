{
  "manifest_version": 3,
  "name": "CodeArchive",
  "version": "0.2.0",
  "description": "Capture accepted algorithm solutions locally for CodeArchive.",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "alarms"],
  "host_permissions": [
    "https://swexpertacademy.com/*",
    "https://school.programmers.co.kr/*",
    "https://jungol.co.kr/*",
    "https://codearchive-dashboard-beta.netlify.app/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CodeArchive",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://swexpertacademy.com/main/solvingProblem/solvingProblem.do*",
        "https://school.programmers.co.kr/learn/courses/30/lessons/*",
        "https://jungol.co.kr/problem/*"
      ],
      "world": "MAIN",
      "js": [
        "mainWorld.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://swexpertacademy.com/main/code/problem/problemDetail.do*",
        "https://swexpertacademy.com/main/code/userProblem/userProblemDetail.do*",
        "https://swexpertacademy.com/main/solvingProblem/solvingProblem.do*",
        "https://school.programmers.co.kr/learn/courses/30/lessons/*",
        "https://jungol.co.kr/problem/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://codearchive-dashboard-beta.netlify.app/*",
      "http://localhost:5173/*"
    ]
  },
  "key": ""
}
