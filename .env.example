# PostgreSQL container (compose.yaml). Choose a unique local password.
POSTGRES_PASSWORD=replace-with-a-local-password

# API PostgreSQL profile. Set these in the API process environment as well.
DB_USERNAME=codearchive
DB_PASSWORD=replace-with-a-local-password

# GitHub sign-in. Set in the API process; never expose secret via VITE_ variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/login/oauth2/code/github
DASHBOARD_ORIGIN=http://localhost:5173
