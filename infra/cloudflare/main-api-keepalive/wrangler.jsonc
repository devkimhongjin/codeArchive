{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "codearchive-main-api-keepalive-beta",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "vars": {
    "MAIN_API_HEALTH_URL": "https://codearchive-api.onrender.com/actuator/health"
  },
  "triggers": {
    "crons": ["*/12 * * * *"]
  }
}
