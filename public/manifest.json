{
  "manifest_version": 3,
  "name": "CodeArchive",
  "version": "0.1.0",
  "description": "코딩테스트 문제 풀이 기록을 관리하는 Chrome Extension",

  "action": {
    "default_title": "CodeArchive",
    "default_popup": "src/popup/index.html"
  },

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "options_page": "src/options/index.html",

  "permissions": [
    "storage",
    "downloads"
  ]
}